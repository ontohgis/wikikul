<https://onto.kul.pl/ontowikikul/>
 a owl:Ontology ;
 rdfs:comment "Ontologia dla modelu danych wiki.kul.pl"@pl ;
 .

schema:description rdf:type owl:AnnotationProperty .

wikibase:Reference rdf:type owl:Class .

skos:altLabel rdf:type owl:AnnotationProperty .

prov:wasDerivedFrom rdf:type owl:AnnotationProperty ;
 rdfs:domain owl:Axiom ;
 rdfs:range wikibase:Reference .

ontowikikul:type
 a rdf:Property
  ;
 rdfs:label
  """typ"""@pl ,
  """type"""@en
  ;
 schema:description
  """obiekt (podmiot) jest instancją klasy; określa przynależność obiektu (jednostki, indywiduum) do klasy (typu, kategorii), np. 'parafia w Krężnicy Jarej' należy do 'klasy' 'parafia'"""@pl ,
  """the subject is an instance of a class; defines the belonging of an object (unit, individual) to a type (class, category), e.g. 'parish in Krężnica Jara' belongs to the 'type' 'parish'."""@en
  ;
 skos:altLabel
  """instance of"""@en ,
  """jest to"""@pl
  ;
 owl:sameAs rdf:type
 .

ontowikikul:deanery_latin_church
 a rdf:Property
  ;
 rdfs:label
  """dekanat (Kościół katolicki ob. łacińskiego)"""@pl ,
  """deanery (Latin Church)"""@en
  ;
 schema:description
  """jednostka terytorialna i administracyjna Kościoła łacińskiego, do której należy opisywany obiekt; nadrzędna w stosunku do parafii, podrzędna w stosunku do archidiakonatu lub diecezji"""@pl ,
  """territorial and administrative unit of the Latin Church to which the item being described belongs; superior to the parish, subordinate to the archdeaconry or diocese"""@en
 .

