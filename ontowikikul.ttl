ontowikikul:subclass_of
 a rdf:Property
  ;
 rdfs:label
  """subclass of"""@en ,
  """podklasa"""@pl
  ;
 schema:description
  """used to indicate that one class is a subclass of another class; this means that every instance of the subclass is also an instance of the main class"""@en ,
  """służy do wskazania, że jedna klasa jest podklasą innej klasy; oznacza, że każdy obiekt należący do podklasy jest również obiektem należącym do klasy głównej"""@pl
  ;
